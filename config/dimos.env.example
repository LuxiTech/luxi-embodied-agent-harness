# Copy this file to config/dimos.local.env for machine-local overrides.
# config/dimos.local.env is ignored by Git.

DIMOS_ASSET_ROOT="${HOME}/work/Asset/dimos"

# "none" disables the extra Rerun window. The MuJoCo window still opens.
DIMOS_VIEWER="none"
# Opening Rerun is opt-in. "native" costs additional VRAM; "web" serves its
# browser viewer. Luxi's own UI does not require either one.
DIMOS_RERUN_OPEN="none"

# Dedicated, host-local LCM bus. Keep ttl=0 for simulation isolation.
DIMOS_LCM_URL="udpm://239.255.76.67:17667?ttl=0&recv_buf_size=4194304"

# Resource safety guard. Every simulation launch refuses to start if another
# DimOS command/MCP port is already listening or the selected GPU has too
# little free VRAM. Basic/benchmark modes require 4096 MiB; perception and
# agent modes require 6144 MiB. Raise this value on shared workstations.
# export LUXI_GPU_INDEX="0"
# export LUXI_MIN_GPU_FREE_MB="8192"
# Keep both overrides disabled in normal use. They require an explicit local
# decision and must never be enabled merely to get past an OOM warning.
# export LUXI_GPU_GUARD="1"
# export LUXI_ALLOW_PARALLEL_SIM="0"

# Isaac Sim 5.1 runs in its own container while DimOS and the UI stay on the
# host. These defaults match the documented workstation layout; uncomment only
# values that differ locally. Start with grid before selecting brownstone.
# export LUXI_ISAAC_GPU_INDEX="1"
# export LUXI_ISAAC_IMAGE="nvcr.io/nvidia/isaac-sim:5.1.0"
# export LUXI_ISAAC_REFERENCE_ROOT="${HOME}/work/SandBox/genie_sim_g1_inspire"
# export LUXI_GENIE_SIM_ROOT="${HOME}/work/SandBox/genie_sim"
# export LUXI_ISAAC_ASSET_ROOT="${HOME}/work/Asset/unitree_sim_isaaclab_usds"
# export LUXI_ISAAC_CACHE_ROOT="${HOME}/work/Asset/genie_sim_isaac_5_1_cache"
# export LUXI_ISAAC_BROWNSTONE_ROOT="${HOME}/work/Asset/isaac_residential_brownstone/content"
# export LUXI_ISAAC_SCENE="grid"
# export LUXI_ISAAC_HEADLESS="1"

# The upstream G1 walking policy keeps stepping at zero velocity. Luxi's
# simulation-only idle state is enabled by default. These are optional tuning
# overrides; set LUXI_G1_IDLE_STABILIZER="0" only for upstream A/B comparison.
# export LUXI_G1_IDLE_STABILIZER="1"
# export LUXI_G1_IDLE_DEADBAND="0.02"
# export LUXI_G1_IDLE_TRANSITION="0.4"
# The pinned ONNX policy does not accurately track planar cmd_vel. By default
# Luxi keeps ONNX leg actuation but makes the simulated floating base follow
# requested x/y/yaw. Disable only when evaluating raw locomotion-policy drift.
# export LUXI_G1_PLANAR_TRACKER="1"
# Optional A/B override; when unset, the upstream [-0.18, 0, -0.09] bias remains.
# export LUXI_G1_ACTIVE_DRIFT_COMPENSATION="-0.18,0,-0.09"

# The launcher removes rendered G1 self-returns by MuJoCo geom/body identity;
# it never deletes all endpoints within a radial near-field zone. The UI treats
# a current-lidar proximity summary older than this as unavailable/fail-closed.
# export LUXI_LIDAR_MAX_AGE="1.25"

# Isaac rolling RTX-lidar costmap. It enables exact-pose/tag planning only
# through same-floor cells already observed free, and also validates the
# already-traversed odometry corridor used by critical safety recovery.
# It does not enable semantic exploration or unknown-space planning.
# Value 60 is the UI's pre-inflated display layer; recovery checks value-100
# measured endpoints with the G1 footprint exactly once. Unknown stays blocked.
# export LUXI_ISAAC_COSTMAP_RESOLUTION="0.10"
# export LUXI_ISAAC_COSTMAP_WIDTH="160"
# export LUXI_ISAAC_COSTMAP_HEIGHT="160"
# export LUXI_ISAAC_COSTMAP_INFLATION="0.30"
# export LUXI_ISAAC_COSTMAP_RANGE="8.0"

# Isaac critical recovery is enabled by default. It atomically stops normal
# writers, waits for the G1 to settle, then retraces fresh odometry breadcrumbs
# through the verified lidar costmap with zero yaw. The learned gait needs a
# 0.40 m/s target to cross the learned policy's measured low-speed dead zone;
# observed body speed remains lower. The runtime still applies
# its 50 Hz slew limiter and every command expires after 0.35 seconds.
# Isaac also stops early in the warning envelope only while the commanded
# translation points toward the nearest current-lidar obstacle. This leaves
# room for the learned gait's measured stop coast; stationary and separating
# motion do not trigger the early guard.
# export LUXI_ISAAC_CRITICAL_RECOVERY="1"
# export LUXI_ISAAC_RECOVERY_GAIT_SPEED="0.40"
# Upper search bound only; recovery stops at the nearest verified good-view
# breadcrumb and does not travel the full distance unless required.
# export LUXI_RECOVERY_MAX_DISTANCE="1.20"
# export LUXI_RECOVERY_TIMEOUT="15"
# export LUXI_RECOVERY_STOP_TIMEOUT="6"
# export LUXI_RECOVERY_PROGRESS_TIMEOUT="3"

# Luxi's UI-local navigation relay connects DimOS /nav_cmd_vel to the G1
# /cmd_vel input. It is simulation-only, bounded and protected by a dead-man
# watchdog. The UI also subscribes to and snapshots /global_costmap.
# export LUXI_NAV_BRIDGE="1"
# export LUXI_NAV_MAX_PLANAR_SPEED="0.22"
# export LUXI_NAV_MAX_YAW_RATE="0.55"
# export LUXI_NAV_WARNING_PLANAR_SPEED="0.10"
# export LUXI_NAV_WARNING_YAW_RATE="0.25"
# export LUXI_NAV_WATCHDOG_SECONDS="0.65"
# Stop transitions enforce a non-configurable minimum 0.5 s late-command barrier.
# Simulation-only A* stuck tuning for bounded speed and sub-real-time MuJoCo.
# Real robot planner defaults are not changed.
# export LUXI_NAV_STUCK_TIME_WINDOW="15"
# export LUXI_NAV_STUCK_DISTANCE="0.15"
# export LUXI_COSTMAP_MONITOR="1"
# export LUXI_COSTMAP_SAVE_INTERVAL="2.0"

# One Agent Harness owns planning, context and tool execution for every robot.
# Qwen is the model adapter; it is not a separate Agent runtime.
# Removed entry/loop selectors are rejected with migration instructions.
# The key stays in a chmod-600 file outside this repo.
# export LUXI_MODEL_PROVIDER="qwen"
# export LUXI_QWEN_API_KEY_FILE="${HOME}/.config/luxi/qwen.key"
# export LUXI_QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# Recommended split: qwen3.7-max plans tools while a dedicated visual model
# handles MCP image skills. To attach first-person JPEGs directly to the UI
# model instead, use qwen3.7-plus here and set LUXI_QWEN_VISION=1.
# export LUXI_QWEN_MODEL="qwen3.7-max"
# export LUXI_QWEN_VISION="0"
# MuJoCo stop_robot, move_robot and turn_around are the first reviewed physical
# capabilities owned by the unified Tool Pipeline, Command Gateway and
# robot-local Safety Kernel. The checked-in gate rejects tools without simulation
# acceptance.
# Emergency rollback only; an explicit list must remain a subset of that gate.
# export LUXI_PHYSICAL_PIPELINE_TOOLS="disabled"
# Third-person is off by default, operator-only, and forcibly disabled in blind mode.
# export LUXI_THIRD_PERSON_ENABLED="1"
# Isaac operator observer defaults to a deliberately low-load 320x180 at 1 FPS.
# It is separate from the Agent's first-person RGB-D stream.
# export LUXI_ISAAC_OBSERVER_ENABLED="1"
# export LUXI_ISAAC_OBSERVER_HZ="1"
# export LUXI_ISAAC_OBSERVER_WIDTH="320"
# export LUXI_ISAAC_OBSERVER_HEIGHT="180"
# Runtime GPU guard: five consecutive 1 s samples at 82 C stop Isaac; 88 C
# or less than 8 GiB free stops immediately. Do not relax without thermal data.
# export LUXI_ISAAC_RUNTIME_MAX_GPU_TEMP_C="82"
# export LUXI_ISAAC_RUNTIME_MAX_GPU_TEMP_SAMPLES="5"
# export LUXI_ISAAC_RUNTIME_HARD_GPU_TEMP_C="88"
# export LUXI_ISAAC_RUNTIME_MIN_GPU_FREE_MB="8192"
# Initial normal-mode UI scene. The browser can switch these later with a full
# stop/clear/restart transaction. Person injection is always explicit.
# office1 | corridor | slalom | alcove | warehouse | office_maze | apartment
# export LUXI_UI_SCENE="office1"
# export LUXI_UI_SCENE_SEED="0"
# export LUXI_UI_SCENE_PERSON="0"
# navigate_with_text 与原生视觉技能使用下面的 VLM。可复用同一个个人 Key：
# export LUXI_DIMOS_VLM_API_KEY_FILE="${HOME}/.config/luxi/qwen.key"
# export LUXI_DIMOS_VLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# export LUXI_DIMOS_VLM_MODEL="qwen3.7-plus"
# G1 MuJoCo only publishes RGB. The default compatibility layer converts a
# visible bbox into one short world-frame A* goal; movement remains bounded by
# the UI tool duration and navigation safety bridge.
# export LUXI_OBJECT_NAVIGATION_COMPAT="1"
# export LUXI_OBJECT_NAV_VERTICAL_FOV="45"
# export LUXI_OBJECT_NAV_GOAL_DISTANCE="1.8"

# The official agentic G1 blueprint defaults to GPT-4o.
# Never commit a real key.
# export OPENAI_API_KEY=""
