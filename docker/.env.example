DIMOS_IMAGE=luxi-dimos:0.0.13-post1
DIMOS_BASE_IMAGE=ubuntu:24.04
DIMOS_UID=1000
DIMOS_GID=1000
DIMOS_MCP_PORT=9990

# Vision tools. Use an absolute host path; never paste the key here.
LUXI_QWEN_KEY_FILE=/home/your-user/.config/luxi/qwen.key
LUXI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LUXI_QWEN_MODEL=qwen3.7-max
LUXI_DIMOS_VLM_MODEL=qwen3.7-plus
